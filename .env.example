# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Anthropic API key (console.anthropic.com) - optional for now.
# Auto-fill from a pasted URL is disabled until this is set; the app works fine with manual entry either way.
ANTHROPIC_API_KEY=

# Shared password to gate access to the app
APP_PASSWORD=change-me
