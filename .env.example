# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Shared password to gate access to the app
APP_PASSWORD=change-me

# Set to "true" only on a public demo deployment: disables the password gate
# and makes all writes (add/edit/delete/URL-fetch) no-ops. Seed sample data
# for that deployment with `npm run db:seed`. Leave unset for your real instance.
DEMO_MODE=true
